{
  "version": 1,
  "about": "The contract between the agents API (AgentsApiServer) and the screen (frontend/src/api.ts). Both sides are tested against this file: the backend answers with these shapes and statuses, the client sends these requests and reads these answers. Operations run in order on a fresh system. null matches any type; arrays are compared by their first element.",
  "operations": [
    {"name": "system", "method": "GET", "path": "/api/system", "status": 200,
     "call": {"fn": "system", "args": []},
     "response": {"mode": "DEMO", "available": ["DEMO"], "prodEnabled": true, "lockedUntil": null, "confirmPhrase": "SWITCH TO PROD"}},
    {"name": "strategies", "method": "GET", "path": "/api/strategies", "status": 200,
     "call": {"fn": "strategies", "args": []},
     "response": [{"id": "trend", "name": "Trend", "description": "d", "params": [{"name": "window", "description": "d", "defaultValue": 200, "min": 20, "max": 400, "integer": true}]}]},
    {"name": "instruments", "method": "GET", "path": "/api/instruments", "status": 200,
     "call": {"fn": "instruments", "args": []}, "response": ["IE00B4L5Y983"]},
    {"name": "limits", "method": "GET", "path": "/api/limits", "status": 200,
     "call": {"fn": "limits", "args": []},
     "response": {"minimumCapital": 40, "minOrderAmount": 10, "maxWeightPerAsset": 0.25}},
    {"name": "createAgent", "method": "POST", "path": "/api/agents", "status": 201,
     "call": {"fn": "createAgent", "args": [{"id": "trend-a", "strategyId": "trend", "params": {"window": 100}, "universe": ["IE00B4L5Y983"], "capital": 40, "steps": [{"afterDays": 30, "capital": 60}]}]},
     "request": {"id": "trend-a", "strategyId": "trend", "params": {"window": 100}, "universe": ["IE00B4L5Y983"], "capital": 40, "steps": [{"afterDays": 30, "capital": 60}]},
     "response": {"id": "trend-a", "strategyId": "trend", "params": {"window": 100, "band": 0.01}, "universe": ["IE00B4L5Y983"], "capital": 40, "steps": [{"afterDays": 30, "capital": 60}], "mode": "DEMO", "state": "ACTIVE"}},
    {"name": "listAgents", "method": "GET", "path": "/api/agents", "status": 200,
     "call": {"fn": "agents", "args": []},
     "response": [{"id": "trend-a", "strategyId": "trend", "params": {"window": 100, "band": 0.01}, "universe": ["IE00B4L5Y983"], "capital": 40, "steps": [{"afterDays": 30, "capital": 60}], "mode": "DEMO", "state": "ACTIVE"}]},
    {"name": "updateAgent", "method": "PUT", "path": "/api/agents/trend-a", "status": 200,
     "call": {"fn": "updateAgent", "args": ["trend-a", {"capital": 50}]},
     "request": {"capital": 50},
     "response": {"id": "trend-a", "strategyId": "trend", "params": {"window": 100, "band": 0.01}, "universe": ["IE00B4L5Y983"], "capital": 50, "steps": [{"afterDays": 30, "capital": 60}], "mode": "DEMO", "state": "ACTIVE"}},
    {"name": "stopAgent", "method": "POST", "path": "/api/agents/trend-a/stop", "status": 200,
     "call": {"fn": "stopAgent", "args": ["trend-a"]},
     "response": {"id": "trend-a", "strategyId": "trend", "params": {"window": 100, "band": 0.01}, "universe": ["IE00B4L5Y983"], "capital": 50, "steps": [{"afterDays": 30, "capital": 60}], "mode": "DEMO", "state": "STOPPED"}},
    {"name": "resumeAgent", "method": "POST", "path": "/api/agents/trend-a/resume", "status": 200,
     "call": {"fn": "resumeAgent", "args": ["trend-a"]},
     "response": {"id": "trend-a", "strategyId": "trend", "params": {"window": 100, "band": 0.01}, "universe": ["IE00B4L5Y983"], "capital": 50, "steps": [{"afterDays": 30, "capital": 60}], "mode": "DEMO", "state": "ACTIVE"}},
    {"name": "auditAgent", "method": "GET", "path": "/api/agents/trend-a/audit", "status": 200,
     "call": {"fn": "audit", "args": ["trend-a"]},
     "response": [{"agentId": "trend-a", "actor": "api:contract", "field": "created", "oldValue": null, "newValue": "trend"}]},
    {"name": "setModeDemo", "method": "PUT", "path": "/api/system/mode", "status": 200,
     "call": {"fn": "setMode", "args": ["DEMO"]}, "request": {"mode": "DEMO"},
     "response": {"mode": "DEMO", "available": ["DEMO"], "prodEnabled": true, "lockedUntil": null, "confirmPhrase": "SWITCH TO PROD"}},
    {"name": "prodChallenge", "method": "POST", "path": "/api/system/prod/challenge", "status": 200,
     "call": {"fn": "requestProd", "args": []},
     "response": {"challengeId": "0123456789abcdef", "expiresAt": "2026-12-01T10:02:00Z", "confirmPhrase": "SWITCH TO PROD"}},
    {"name": "prodConfirmRejected", "method": "POST", "path": "/api/system/prod/confirm", "status": 403,
     "call": {"fn": "confirmProd", "args": ["0123456789abcdef", "000000", "SWITCH TO PROD"]},
     "request": {"challengeId": "0123456789abcdef", "code": "000000", "phrase": "SWITCH TO PROD"},
     "response": {"error": "confirmation rejected: ask for a new challenge and try again"}},
    {"name": "setModeProdRefused", "method": "PUT", "path": "/api/system/mode", "status": 409,
     "call": {"fn": "setMode", "args": ["PROD"]}, "request": {"mode": "PROD"},
     "response": {"error": "PROD cannot be selected directly"}},
    {"name": "duplicateAgent", "method": "POST", "path": "/api/agents", "status": 409,
     "request": {"id": "trend-a", "strategyId": "trend", "universe": ["IE00B4L5Y983"], "capital": 40},
     "response": {"error": "agent trend-a already exists"}},
    {"name": "badAgent", "method": "POST", "path": "/api/agents", "status": 400,
     "request": {"id": "x", "strategyId": "trend", "universe": ["IE00B4L5Y983"], "capital": 1},
     "response": {"error": "capital is below the minimum"}},
    {"name": "unknownAgent", "method": "GET", "path": "/api/agents/ghost", "status": 404,
     "response": {"error": "unknown agent: ghost"}},
    {"name": "wrongMethod", "method": "GET", "path": "/api/agents/trend-a/stop", "status": 405,
     "response": {"error": "method not allowed: use POST"}},
    {"name": "noToken", "method": "GET", "path": "/api/agents", "status": 401, "auth": false,
     "response": {"error": "unauthorized"}}
  ]
}
