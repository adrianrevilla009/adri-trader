<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.adrianrevilla.trading</groupId>
    <artifactId>etf-trading-bot</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>trading-app</artifactId>
  <name>trading-app</name>
  <description>Spring Boot application, scheduled jobs, alerts</description>

  <dependencies>
    <dependency><groupId>com.adrianrevilla.trading</groupId><artifactId>trading-core</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.adrianrevilla.trading</groupId><artifactId>trading-data</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.adrianrevilla.trading</groupId><artifactId>trading-backtest</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.adrianrevilla.trading</groupId><artifactId>trading-strategies</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.adrianrevilla.trading</groupId><artifactId>trading-risk</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.adrianrevilla.trading</groupId><artifactId>trading-execution</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.adrianrevilla.trading</groupId><artifactId>trading-broker-sim</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.adrianrevilla.trading</groupId><artifactId>trading-broker-etoro</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.adrianrevilla.trading</groupId><artifactId>trading-arena</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.adrianrevilla.trading</groupId><artifactId>trading-tax</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>

    <dependency><groupId>org.testcontainers</groupId><artifactId>postgresql</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution><goals><goal>repackage</goal></goals></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
