<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.adrianrevilla.trading</groupId>
  <artifactId>etf-trading-bot</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>etf-trading-bot</name>

  <modules>
    <module>trading-core</module>
    <module>trading-data</module>
    <module>trading-strategies</module>
    <module>trading-risk</module>
    <module>trading-backtest</module>
    <module>trading-execution</module>
    <module>trading-arena</module>
    <module>trading-tax</module>
    <module>trading-broker-sim</module>
    <module>trading-broker-etoro</module>
    <module>trading-application</module>
    <module>trading-adapter-persistence</module>
    <module>trading-adapter-marketdata</module>
    <module>trading-adapter-notification</module>
    <module>trading-adapter-web</module>
    <module>trading-adapter-metrics</module>
    <module>trading-app</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.5.14</spring-boot.version>
    <!-- Security overrides: versions with fixes newer than what Spring Boot manages. Remove when Boot catches up. -->
    <jackson-bom.version>2.23.0</jackson-bom.version>
    <micrometer-bom.version>1.15.12</micrometer-bom.version>
    <spring-framework-bom.version>6.2.19</spring-framework-bom.version>
    <postgresql.override.version>42.7.14</postgresql.override.version>
    <archunit.version>1.4.0</archunit.version>
    <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.micrometer</groupId>
        <artifactId>micrometer-bom</artifactId>
        <version>${micrometer-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-framework-bom</artifactId>
        <version>${spring-framework-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql.override.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.adrianrevilla.trading</groupId>
        <artifactId>trading-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.adrianrevilla.trading</groupId>
        <artifactId>trading-data</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.adrianrevilla.trading</groupId>
        <artifactId>trading-strategies</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.adrianrevilla.trading</groupId>
        <artifactId>trading-risk</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.adrianrevilla.trading</groupId>
        <artifactId>trading-backtest</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.adrianrevilla.trading</groupId>
        <artifactId>trading-execution</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.adrianrevilla.trading</groupId>
        <artifactId>trading-arena</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.adrianrevilla.trading</groupId>
        <artifactId>trading-tax</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.adrianrevilla.trading</groupId>
        <artifactId>trading-broker-sim</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.adrianrevilla.trading</groupId>
        <artifactId>trading-broker-etoro</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.adrianrevilla.trading</groupId>
        <artifactId>trading-application</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.adrianrevilla.trading</groupId>
        <artifactId>trading-adapter-persistence</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.adrianrevilla.trading</groupId>
        <artifactId>trading-adapter-marketdata</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.adrianrevilla.trading</groupId>
        <artifactId>trading-adapter-notification</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.adrianrevilla.trading</groupId>
        <artifactId>trading-adapter-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.adrianrevilla.trading</groupId>
        <artifactId>trading-adapter-metrics</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.adrianrevilla.trading</groupId>
        <artifactId>trading-app</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Test dependencies shared by every module (ADR-0012). -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
          <configuration><release>21</release><parameters>true</parameters></configuration>
        </plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-clean-plugin</artifactId><version>3.4.0</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.3.1</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-install-plugin</artifactId><version>3.1.3</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-deploy-plugin</artifactId><version>3.1.3</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-site-plugin</artifactId><version>3.12.1</version></plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- Policy from ai-project-factory (policies/maven-enforcer, skill enforcer-rules): libraries the project does not use. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-project-rules</id>
            <phase>validate</phase>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <fail>true</fail>
              <rules>
                <!-- the factory example asks for 3.9; the local machine has 3.8.6 and CI/Docker use 3.9, so the floor is 3.8.6 -->
                <requireMavenVersion><version>[3.8.6,)</version></requireMavenVersion>
                <requireJavaVersion><version>[21,)</version></requireJavaVersion>
                <requirePluginVersions/>
                <banDuplicatePomDependencyVersions/>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>org.projectlombok:lombok</exclude>
                    <exclude>log4j:log4j</exclude>
                    <exclude>commons-collections:commons-collections</exclude>
                    <exclude>joda-time:joda-time</exclude>
                  </excludes>
                  <message>Library banned by the factory catalog (forbidden-libraries) and ADR-0012.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <execution><goals><goal>prepare-agent</goal></goals></execution>
          <execution><id>report</id><phase>verify</phase><goals><goal>report</goal></goals></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
