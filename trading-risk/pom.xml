<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.adrianrevilla.trading</groupId>
    <artifactId>etf-trading-bot</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>trading-risk</artifactId>
  <name>trading-risk</name>
  <description>Risk rules and kill switch</description>
  <dependencies>
    <dependency><groupId>com.adrianrevilla.trading</groupId><artifactId>trading-core</artifactId></dependency>
  </dependencies>
  <!-- Pure domain/application module (ADR-0025): no framework or driver may ever reach its classpath, not even transitively. -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-pure-domain</id>
            <phase>validate</phase>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>org.springframework:*</exclude>
                    <exclude>org.springframework.boot:*</exclude>
                    <exclude>jakarta.persistence:*</exclude>
                    <exclude>com.fasterxml.jackson.core:*</exclude>
                    <exclude>org.postgresql:*</exclude>
                    <exclude>org.flywaydb:*</exclude>
                    <exclude>io.micrometer:*</exclude>
                  </excludes>
                  <message>This module is domain/application: frameworks and drivers belong to an adapter (ADR-0025).</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
