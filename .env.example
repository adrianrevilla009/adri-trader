# Copy to .env (`make init` does it and generates the passwords). .env is git-ignored: never commit it.
DB_USER=trading
DB_PASSWORD=
GRAFANA_PASSWORD=

# Telegram: alerts from the bot AND from Prometheus/Alertmanager. Create the bot with @BotFather; chat id is a number.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Token (16+ characters) for the kill-switch endpoint. Empty = endpoint disabled.
KILL_SWITCH_TOKEN=

# Token (16+ characters) for the agents API used by the screen (frontend/). Empty = the API is off.
TRADING_API_TOKEN=

# eToro demo keys (phase 0). Only in this file, never in chat or in the repository.
ETORO_API_KEY=
ETORO_USER_KEY=

# First day the arena agents trade (yyyy-MM-dd); earlier data is only history.
ARENA_START_DATE=

# Optional: URL of an external dead-man's-switch (e.g. a healthchecks.io check). Receives a ping every 5 minutes
# while alerting is alive; the service alerts you when the pings stop (VM dead, Docker dead, Alertmanager dead).
HEARTBEAT_URL=

# Spring profile: dev | paper | live
SPRING_PROFILES_ACTIVE=dev
